{
  "name": "dhcb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "qs": "^6.16.0"
  },
  "scripts": {
    "dev": "vite --config apps/dhcb/vite.config.ts",
    "build": "node scripts/gen-data-manifest.mjs && node scripts/gen-stories-json.mjs && tsc -p apps/dhcb/tsconfig.json && tsc -p tsconfig.api.json && vite build --config apps/dhcb/vite.config.ts && npm run build:server && npm run build --workspace=@dhcb/hub",
    "build:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && npm run build:packages && tsc -p tsconfig.server.json",
    "build:packages": "tsc -b tsconfig.packages.json",
    "typecheck": "tsc -p apps/dhcb/tsconfig.json && tsc -p tsconfig.api.json && tsc -p tsconfig.e2e.json && tsc -p apps/hub/tsconfig.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "budget": "tsx scripts/check-budget-margin.ts",
    "start": "tsx apps/server/src/server.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --config apps/dhcb/vite.config.ts",
    "codemap": "tsx scripts/codemap.ts",
    "check:specs": "tsx scripts/check-spec-paths.ts",
    "check:protocol": "tsx scripts/protocol-check.ts",
    "check:docs": "bash scripts/check-docs-consistency.sh",
    "check:claude-md": "tsx scripts/check-claude-md-moved.ts",
    "check:sql": "tsx scripts/check-sql-prepare.ts",
    "review:ocr": "npx -y @alibaba-group/open-code-review@1.12.11",
    "review:ocr:preview": "npx -y @alibaba-group/open-code-review@1.12.11 delegate preview --from origin/main --to HEAD",
    "maintain": "bash scripts/maintenance-sweep.sh",
    "shots:learning-ux": "tsx scripts/shots-learning-ux.ts",
    "shots:lesson-anim": "tsx --tsconfig tsconfig.base.json scripts/shots-lesson-animations.ts",
    "cwv:prod": "bash scripts/lighthouse-cwv.sh",
    "audit:lessons": "tsx scripts/audit-lessons.ts",
    "audit:prose": "tsx scripts/audit-prose.ts",
    "changelog": "tsx scripts/changelog.ts",
    "eval:tutor": "npx tsx scripts/eval-tutor.ts",
    "eval:code-feedback": "npx tsx scripts/eval-code-feedback.ts",
    "eval:v2:routing": "npx tsx scripts/eval-v2-routing.ts",
    "eval:v2:memory": "npx tsx scripts/eval-v2-memory.ts",
    "eval:v2:permissions": "npx tsx scripts/eval-v2-permissions.ts",
    "eval:v2:context": "npx tsx scripts/eval-v2-context.ts",
    "eval:v2:red-team": "npx tsx scripts/red-team/eval-red-team.ts",
    "eval:v2:privacy": "npx tsx scripts/eval-v2-privacy.ts",
    "eval:v2:audit": "npx tsx scripts/eval-v2-final-audit.ts",
    "seed:pronunciation": "tsx scripts/seed-pronunciations.ts",
    "tag:cefr": "tsx scripts/tag-cefr-levels.ts",
    "tag:freq": "tsx scripts/assign-word-freq.ts",
    "gen:word-forms": "tsx scripts/archive/gen-word-forms.ts",
    "gen:form-examples": "tsx scripts/archive/gen-form-examples.ts",
    "gen:stories": "node scripts/gen-stories-json.mjs",
    "gen:lesson-index": "tsx scripts/gen-lesson-index.ts",
    "gen:subject-catalog": "tsx scripts/gen-subject-catalog.ts",
    "extract:words-cefr": "tsx scripts/archive/extract-words-cefr-subset.ts",
    "prefetch:tts-patterns": "tsx scripts/prefetch-tts-patterns.ts",
    "rank:patterns": "tsx scripts/archive/rank-common-patterns.ts",
    "seed:all": "tsx scripts/seed-all.ts",
    "seed:verify": "tsx scripts/seed-all.ts --verify",
    "seed:stories:gemini": "tsx scripts/seed-stories-gemini-tts.ts",
    "eleven:tone-sample": "tsx scripts/eleven-tone-sample.ts",
    "migrate:pg": "tsx scripts/run-pg-migrations.ts",
    "smoke:gemini-live": "tsx scripts/smoke-gemini-live.ts",
    "migrate:verify": "npx tsx scripts/verify-v2-migration-safety.ts",
    "backup:r2": "tsx scripts/backup-pg-to-r2.ts",
    "restore:r2": "tsx scripts/restore-pg-from-r2.ts",
    "backup:env": "tsx scripts/backup-env-to-r2.ts",
    "restore:env": "tsx scripts/restore-env-from-r2.ts",
    "backup:system": "tsx scripts/backup-system-to-r2.ts",
    "restore:system": "tsx scripts/restore-system-from-r2.ts",
    "restore:all": "tsx scripts/restore-all-from-r2.ts",
    "loadtest:k6": "k6 run scripts/load-test/k6-baseline.js",
    "stress:test": "tsx scripts/stress-test.ts",
    "prepare": "husky",
    "swift:conformance": "tsx scripts/swift-conformance.ts",
    "kotlin:conformance": "tsx scripts/kotlin-conformance.ts",
    "gen:feature-map": "tsx scripts/gen-feature-map.ts",
    "gen:stem-lesson-index": "tsx scripts/gen-stem-lesson-index.ts",
    "review:status": "tsx scripts/review-status.ts",
    "export:review-queue": "tsx scripts/export-review-queue.ts",
    "review:sync": "tsx scripts/review-sync.ts",
    "size:chunks": "tsx scripts/check-lesson-chunks.ts",
    "check:ui-ux": "vitest run scripts/ui-ux-decision-contract.test.ts scripts/a11y-gate-policy.test.ts scripts/contrast-audit.test.ts scripts/fixed-color-contrast-audit.test.ts apps/dhcb/src/lib/themeContrast.test.ts packages/core-ui/theme.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/genai": "^2.27.0",
    "@sentry/node": "^11.4.0",
    "@sentry/react": "^11.4.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.52.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2",
    "typescript": "^5.2.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cli-progress": "^3.11.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "cli-progress": "^3.12.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "size-limit": "^14.0.0",
    "subtlex-word-frequencies": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.0"
  }
}
