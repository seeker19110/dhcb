{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "model": "opusplan",
  "fallbackModel": ["opus", "fable"],
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "mcp__github__create_pull_request"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "mcp__github__merge_pull_request",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git restore -- .)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "bash .claude/report-status.sh" }]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/session-start.sh", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/block-dangerous-git.sh" },
          { "type": "command", "command": "bash .claude/hooks/block-pipe-to-shell.sh" },
          { "type": "command", "command": "bash .claude/hooks/pre-commit-gate.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre-bash-guard.sh", "timeout": 600 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/config-protection.sh" },
          { "type": "command", "command": "bash .claude/hooks/shared-file-reminder.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre-edit-guard.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__.*(merge_pull_request|auto_merge).*",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre-mcp-guard.sh", "timeout": 120 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/auto-format.sh", "timeout": 30 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/precompact-checkpoint.sh" }]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre-compact.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/usage-guard.sh" }]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/stop-guard.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
