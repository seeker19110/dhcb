{
  // tsconfig.base.json — compilerOptions dùng chung cho frontend (tách từ tsconfig gốc ở PR-S2).
  // baseUrl/paths khai ở ĐÂY (gốc repo) nên mọi tsconfig extends đều phân giải @dhcb/@core
  // về đúng source, kể cả tsx (đọc paths qua chuỗi extends của tsconfig.json gốc).
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@core/*": ["./packages/core-ui/*"],
      "@dhcb/*": ["./packages/*"]
    }
  }
}
